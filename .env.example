# ---------------------------------------------------------------
# Buildable Labs Billing — environment
# Copy to .env.local (local dev) and paste the same into Vercel.
# ---------------------------------------------------------------

# 1. SUPABASE  (Project Settings -> API)  — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. APP URL — used in emails + public invoice links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. RESEND (resend.com -> API Keys) — for "Send to client"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend, e.g. billing@buildablelabs.com
INVOICE_FROM_EMAIL="Buildable Labs <billing@updates.buildablelabs.com>"
INVOICE_BCC_EMAIL=akhil@buildablelabs.com

# 4. CLAUDE (console.anthropic.com) — for the chat-to-invoice bar
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# 5. CRON — Vercel hits GET /api/cron/recurring every night at 03:00 UTC
#    (see vercel.json). This is NOT a Supabase cron. Same secret protects the URL.
#    Locally, retainers will not auto-fire — use Retainers → "Run due now",
#    or ask the assistant: "run due retainers".
CRON_SECRET=change-me-to-something-random
