# ---------------------------------------------------------------
# Munshi — environment
# Copy to .env.local (local dev) and paste the same into Vercel.
# ---------------------------------------------------------------

# 1. SUPABASE  (Project Settings -> API)  — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. APP URL — used in emails + public invoice links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. SECRET ENCRYPTION — REQUIRED before anyone can save their own API keys.
#    Customer keys are stored AES-256-GCM encrypted with this. 32 bytes, base64.
#    Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#    WARNING: rotating this makes every stored customer key unreadable. They
#    fall back to the platform keys below and must re-paste theirs.
APP_ENCRYPTION_KEY=

# 4. AI ENGINES
#    DeepSeek answers first (roughly a tenth the cost per request).
#    Claude is the automatic fallback AND the only one that can read receipt
#    images, so keep it set even if DeepSeek is your primary.
#    Either can be overridden per-workspace on the Integrations page.
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# 5. RESEND (resend.com -> API Keys) — for "Send to client"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend, e.g. billing@updates.yourdomain.com
INVOICE_FROM_EMAIL="Munshi <billing@updates.buildablelabs.com>"
INVOICE_BCC_EMAIL=akhil@buildablelabs.com

# 6. CRON — Vercel hits GET /api/cron/recurring every night at 03:00 UTC
#    (see vercel.json). This is NOT a Supabase cron. Same secret protects the URL.
#    Locally, retainers will not auto-fire — use Retainers → "Run due now",
#    or ask the assistant: "run due retainers".
CRON_SECRET=change-me-to-something-random
